{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "sh -c '. ./env-defaults.sh && react-native run-android --port \"$METRO_PORT\" --deviceId \"$DEVICE_SERIAL\"'",
    "android:emu": "sh -c '. ./env-defaults.sh && react-native run-android --active-arch-only --port \"$METRO_PORT\" --deviceId \"$DEVICE_SERIAL\"'",
    "emulator": "sh -c '. ./env-defaults.sh && \"${ANDROID_HOME:-$HOME/Library/Android/sdk}/emulator/emulator\" -avd \"$AVD_NAME\" -port \"$EMULATOR_PORT\"'",
    "ios": "react-native run-ios",
    "icons:android": "bash scripts/logo-gen-android.sh",
    "icons:ios": "bash scripts/logo-gen-ios.sh",
    "icons:all": "yarn icons:android && yarn icons:ios",
    "build:android:apk": "cd android && bundle exec fastlane build_apk",
    "build:android:aab": "cd android && bundle exec fastlane build_app_bundle",
    "build:ios:sim": "cd ios && bundle exec fastlane build_simulator",
    "build:ios:ipa": "cd ios && bundle exec fastlane build_ipa",
    "build:ios:beta": "cd ios && bundle exec fastlane beta",
    "version:show": "node scripts/version.js show",
    "version:bump": "node scripts/version.js bump",
    "version:build": "node scripts/version.js build",
    "lint": "eslint .",
    "pack:build": "node scripts/build-assistant-pack.js",
    "prestart": "node scripts/build-assistant-pack.js",
    "start": "sh -c '. ./env-defaults.sh && react-native start --port \"$METRO_PORT\"'",
    "launch:android": "sh -c '. ./env-defaults.sh && adb -s \"$DEVICE_SERIAL\" shell am start -W -a android.intent.action.VIEW -d \"$DEEPLINK\"'",
    "launch:ios": "sh -c 'xcrun simctl openurl booted \"$DEEPLINK\"'",
    "test": "jest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.15",
